{
  "name": "norcook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/imageops-release.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:images": "node scripts/check-image-budgets.mjs",
    "check:visuals": "node scripts/imageops-release.mjs && node --test scripts/imageops-release.test.mjs",
    "verify:visuals:live": "node scripts/imageops-release.mjs --live",
    "check:sitemap": "playwright test tests/e2e/site.spec.ts --grep \"sitemap\"",
    "optimize:images": "node scripts/optimize-images.mjs",
    "audit:dependencies": "pnpm audit --prod --audit-level=high",
    "check:security-floor": "node scripts/check-security-floor.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:e2e": "playwright test",
    "test:performance:mobile": "node scripts/run-lighthouse.mjs mobile",
    "test:performance:desktop": "node scripts/run-lighthouse.mjs desktop",
    "capture:screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "release:check": "pnpm lint && pnpm typecheck && pnpm check:content && pnpm check:images && pnpm audit:dependencies && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "lighthouse": "13.4.1",
    "postcss": "^8.5.26",
    "sharp": "0.35.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3"
  }
}
